{
  "name": "ordin",
  "version": "4.0.0",
  "private": true,
  "description": "Ördin — Next-Gen Community Ecology statistical app (Tauri + React + Vite + Zustand + DuckDB-WASM + deck.gl + webR). Statistical first; MapLibre only optional for lon/lat site maps.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-dependency-patches.mjs",
    "dev": "npm run dev -w ordin-desktop",
    "build": "npm run build -w ordin-desktop",
    "preview": "npm run preview -w ordin-desktop",
    "tauri": "npm run tauri -w ordin-desktop",
    "tauri:dev": "npm run tauri:dev -w ordin-desktop",
    "lint": "eslint apps packages workers tests",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:frontend": "node --import tsx --test tests/*.test.ts",
    "legacy:start": "npm run start --workspace=ordin --if-present",
    "legacy:electron": "node --version && npx --yes electron-forge start --help 2>&1 | head"
  },
  "dependencies": {
    "patch-package": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.6.2",
    "eslint": "^9.11.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "@loaders.gl/compression": { "fflate": "^0.8.3" },
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.7",
    "miniflare": { "undici": "^7.16.0" },
    "sweepline-intersections": "^1.5.0",
    "sweep-line-intersections": "^1.5.0",
    "textura-compressor": { "image-size": "^2.0.4" },
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@google/genai": true,
    "core-js": true,
    "esbuild": true,
    "protobufjs": true,
    "sharp": true,
    "workerd": true
  },
  "trustedDependencies": [
    "@google/genai",
    "core-js",
    "esbuild",
    "protobufjs",
    "sharp",
    "workerd"
  ]
}
