# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# R files
*.R text
*.Rmd text
*.Rdata binary
*.rds binary

# Documentation
*.md text
*.txt text

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary

# JavaScript sources must stay UTF-8 + LF (regression guard for the shiny-ui.js UTF-16 incident)
*.js text eol=lf
